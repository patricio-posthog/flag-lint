    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
